{
  "protocol_version": 1,
  "type": "engine",
  "id": "claude",
  "name": { "en": "Claude Code", "zh": "Claude Code" },
  "description": { "en": "Runs tasks with Claude Code", "zh": "用 Claude Code 执行任务" },
